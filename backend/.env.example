MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yassinetoumi111@gmail.com
MAIL_PASSWORD="votre_mot_de_passe_application"
MAIL_FROM_ADDRESS=yassinetoumi111@gmail.com
MAIL_FROM_NAME=Rentvly
