# Local Herd: APP_URL + API = http://backend.test
# DB/Mongo: remote server IP (not Docker internal hostnames like bieniciscraper-...)

APP_NAME=Rentvly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://backend.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=rentvly_db
DB_USERNAME=rentvly
DB_PASSWORD=rentvly

MONGO_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGO_DATABASE=bienici

MONGO_IMPORT_DSN=mongodb://root:root@127.0.0.1:27017/?authSource=admin
MONGO_IMPORT_DATABASE=bienici
MONGO_IMPORT_VENTES_COLLECTION=ventes_clean

PREDICTION_API_URL=http://127.0.0.1:8000

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
SANCTUM_TOKEN_EXPIRATION=43200

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail — Gmail SMTP
