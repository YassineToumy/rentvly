# ============================================================
# Rentvly — variables Docker Compose (copier vers .env)
#   cp .env.example .env
#   docker compose up --build -d
# ============================================================

# --- Ports exposés sur la machine hôte ---
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
API_PYTHON_HOST_PORT=8000
POSTGRES_HOST_PORT=5432

# --- Frontend (URL appelée par le navigateur) ---
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# --- Backend Laravel ---
APP_NAME=Rentvly
APP_ENV=local
APP_KEY=base64:dGVtcG9yYXJ5a2V5Zm9yZG9ja2VyYnVpbGQxMjM0NTY3ODkw
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL local (Docker)
# - Depuis les containers : DB_HOST=postgres (forcé dans compose)
# - Depuis la machine (Herd / DBeaver) : localhost:5432
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=rentvly_db
DB_USERNAME=rentvly
DB_PASSWORD=rentvly

# Mongo distant = source des annonces (import → Postgres local)
MONGO_URI=mongodb://root:root@72.60.215.111:27019
MONGO_DATABASE=bienici
MONGO_IMPORT_DSN=mongodb://root:root@72.60.215.111:27019
MONGO_IMPORT_DATABASE=bienici
MONGO_IMPORT_VENTES_COLLECTION=ventes

# Hostname Docker interne (ne pas utiliser localhost ici)
PREDICTION_API_URL=http://api-python:8000

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- API Python (ML) ---
API_PYTHON_PORT=8000
MODEL_PATH=model.cbm
METADATA_PATH=model_metadata.json
MONGODB_URI=mongodb://root:root@72.60.215.111:27019
MONGO_LOCATIONS_COLLECTION=locations_clean
