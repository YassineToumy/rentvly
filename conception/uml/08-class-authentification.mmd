%% Diagramme de classes — Authentification Rentvly
%% Style compact : classes rapprochées, relations en lignes (Overleaf)

%%{init: {
  'theme': 'base',
  'themeVariables': {
    'fontFamily': 'Arial, Helvetica, sans-serif',
    'fontSize': '14px',
    'background': '#ffffff',
    'primaryColor': '#ffffff',
    'primaryTextColor': '#000000',
    'primaryBorderColor': '#000000',
    'lineColor': '#000000',
    'secondaryColor': '#ffffff',
    'tertiaryColor': '#ffffff',
    'mainBkg': '#ffffff',
    'textColor': '#000000',
    'classText': '#000000'
  }
}}%%

classDiagram
    direction LR

    class Utilisateur {
        +int id
        +string name
        +string email
        +string role
        +string password
        +datetime email_verified_at
        +datetime created_at
        +isAdmin() bool
        +estimations() HasMany
    }

    class JetonAcces {
        +int id
        +string tokenable_type
        +int tokenable_id
        +string name
        +string token
        +datetime last_used_at
        +datetime expires_at
    }

    class TokenReset {
        +string email PK
        +string token
        +datetime created_at
    }

    class Session {
        +string id PK
        +int user_id FK
        +string ip_address
        +text payload
        +int last_activity
    }

    class ControleurAuth {
        +register()
        +login()
        +logout()
        +me()
    }

    Utilisateur "1" --> "*" JetonAcces : possede
    Utilisateur "1" --> "*" Session : a
    Utilisateur ..> TokenReset : email
    ControleurAuth ..> Utilisateur : gere
    ControleurAuth ..> JetonAcces : cree/revoque
