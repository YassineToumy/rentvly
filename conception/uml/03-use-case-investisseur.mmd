flowchart LR

    Investisseur@{ img: "data:image/png;base64,", label: "Investisseur", w: 45, h: 95, pos: "b", constraint: "off" }
    ML["Service ML"]

    subgraph SYS ["Rentvly — Espace investisseur"]
      direction TB

      subgraph G1 ["Tableau de bord"]
        UC_DASH(["Accéder au tableau de bord"])
        UC_DETEST(["Consulter une estimation"])
        UC_DEL(["Supprimer une estimation"])
      end

      subgraph G2 ["Estimations sauvegardées"]
        UC_SAVE(["Enregistrer une estimation"])
        UC_VAR(["Créer une sous-estimation"])
        UC_EST(["Estimer un loyer"])
      end

      subgraph G3 ["Investissement"]
        UC_BUY(["Marquer comme acheté"])
        UC_UNBUY(["Retirer statut acheté"])
        UC_ROI(["Voir projections ROI"])
      end

      subgraph G4 ["Compte"]
        UC_SET(["Gérer les paramètres"])
        UC_OUT(["Se déconnecter"])
      end
    end

    Investisseur --- UC_DASH
    Investisseur --- UC_DETEST
    Investisseur --- UC_DEL
    Investisseur --- UC_SAVE
    Investisseur --- UC_BUY
    Investisseur --- UC_UNBUY
    Investisseur --- UC_SET
    Investisseur --- UC_OUT

    UC_SAVE -. include .-> UC_EST
    UC_ROI -. include .-> UC_BUY
    UC_VAR -. extend .-> UC_SAVE
    UC_BUY -. extend .-> UC_DETEST
    UC_UNBUY -. extend .-> UC_DETEST

    UC_EST --- ML

    classDef uc fill:#ffffff,stroke:#000000,color:#000000
    classDef sys fill:#ffffff,stroke:#000000,color:#000000,stroke-dasharray:4 2
    classDef group fill:#ffffff,stroke:#000000,color:#000000

    class UC_DASH,UC_DETEST,UC_DEL,UC_SAVE,UC_VAR,UC_EST,UC_BUY,UC_UNBUY,UC_ROI,UC_SET,UC_OUT uc
    class ML sys
    class G1,G2,G3,G4 group

    style SYS fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000
    style G1 fill:#ffffff,stroke:#000000,color:#000000
    style G2 fill:#ffffff,stroke:#000000,color:#000000
    style G3 fill:#ffffff,stroke:#000000,color:#000000
    style G4 fill:#ffffff,stroke:#000000,color:#000000

    linkStyle default stroke:#000000
