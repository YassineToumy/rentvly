classDiagram
    direction TB

    class User {
        +int id
        +string name
        +string email
        +string password
        +string role
        +string avatar
        +datetime email_verified_at
        +datetime created_at
        +datetime updated_at
        +isAdmin() bool
        +estimations() HasMany
    }

    class Estimation {
        +int id
        +int user_id FK
        +string listing_id
        +int parent_id FK
        +string city
        +string postal_code
        +string district_name
        +string property_type
        +int surface_area
        +int rooms
        +float predicted_rent
        +float purchase_price
        +float net_yield
        +bool is_purchased
        +datetime purchased_at
        +json form_data
        +json prediction
        +json rentability
        +datetime created_at
        +datetime updated_at
        +user() BelongsTo
        +parent() BelongsTo
        +variants() HasMany
        +isRoot() bool
        +latestPurchasePrice() float
    }

    class Vente {
        +int id
        +string external_id
        +string title
        +text description
        +string property_type
        +bool is_new_property
        +int price
        +decimal price_per_sqm
        +bool price_has_decreased
        +bool reduced_vat
        +decimal surface_area
        +int rooms_quantity
        +decimal surface_per_room
        +json interior_features
        +json exterior_features
        +json other_features
        +int equipment_score
        +string city
        +string postal_code
        +string code_commune FK
        +string department_code FK
        +string code_region FK
        +string district_name
        +string code_insee
        +decimal latitude
        +decimal longitude
        +string owner_type
        +string owner_name
        +bool is_pro
        +json photos
        +int photos_count
        +datetime publication_date
        +datetime modification_date
        +date delivery_date
        +datetime scraped_at
        +datetime cleaned_at
        +commune() BelongsTo
        +departement() BelongsTo
        +region() BelongsTo
    }

    class Region {
        +string code_region PK
        +string nom
        +datetime created_at
        +datetime updated_at
        +departments() HasMany
    }

    class Departement {
        +string code_departement PK
        +string nom
        +string code_region FK
        +datetime created_at
        +datetime updated_at
        +region() BelongsTo
        +communes() HasMany
    }

    class Commune {
        +string code_commune PK
        +string nom
        +string code_departement FK
        +string code_region FK
        +string siren
        +string code_epci
        +int population
        +datetime created_at
        +datetime updated_at
        +departement() BelongsTo
        +region() BelongsTo
    }

    class AncienneRegion {
        +string code_ancienne_region PK
        +string nom
        +string code_region FK
        +region() BelongsTo
    }

    note for Estimation "listing_id = string nullable\n(pas de belongsTo Vente)"
    note for AncienneRegion "Modele present, aucune migration\nni usage ailleurs dans le code"

    %% Relations Eloquent reelles
    User "1" --> "*" Estimation : estimations()
    Estimation "0..1" --> "*" Estimation : variants() / parent_id
    Region "1" --> "*" Departement : departments()
    Departement "1" --> "*" Commune : communes()
    AncienneRegion "*" --> "1" Region : region()
    Vente "*" --> "0..1" Commune : commune()
    Vente "*" --> "0..1" Departement : departement()
    Vente "*" --> "0..1" Region : region()
